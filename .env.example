# Copy this file to .env at the repository root. Fill blank required values.
# VITE_* values are embedded in the browser build. Never use VITE_ for secrets.
# The future Vite app must load this root directory with envDir; the API must
# load this same file from the repository root.

# Web app and local API
VITE_API_BASE_URL=http://localhost:3001/api
WEB_ORIGIN=http://localhost:5173
PORT=3001

# Firebase Authentication: copy these four values from the Firebase web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin: same project ID as VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Local non-emulator development: absolute path to an Admin service account JSON
# stored OUTSIDE this repository. On Google-hosted deployments use the runtime's
# Application Default Credentials instead and leave this variable unset.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/firebase-admin.json

# Private S3 bucket for panoramas, plans, and generated thumbnails.
AWS_REGION=
S3_BUCKET=
# Use one AWS credential source: role/Identity Center/profile is preferred.
# AWS_PROFILE=pano-viewer-dev
# If a deployment environment supplies temporary credentials instead:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Local S3-compatible service only; leave unset for Amazon S3.
# S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=false

# SQLite: relative paths are resolved from the repository root.
DATABASE_PATH=./data/pano-viewer.sqlite

# Media limits and short-lived S3 URL durations.
MAX_PANORAMA_BYTES=104857600
MAX_PLAN_BYTES=20971520
S3_UPLOAD_URL_TTL_SECONDS=600
S3_READ_URL_TTL_SECONDS=900

# Local Firebase Authentication emulator only; NEVER set in production.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
